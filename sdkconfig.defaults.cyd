# ESP32-2432S028R, dual USB, 4MB Flash, no PSRAM.
CONFIG_IDF_TARGET="esp32"
CONFIG_BSP_BOARD_CYD=y
# Measured on CYD/X2D: reuse snapshot TLS; retain a short scheduling margin.
CONFIG_CAMERA_REFRESH_DELAY_MS=100
CONFIG_CAMERA_REUSE_SESSION=y
CONFIG_CAMERA_BUFFERED_PREVIEW=y
# Reserve instruction RAM for the fitted RGB565 preview, keeping DRAM for TLS.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
CONFIG_BSP_CYD_LCD_ST7789=y
CONFIG_BSP_CYD_LCD_BGR=y
# CONFIG_BSP_CYD_LCD_INVERT is not set
CONFIG_BSP_CYD_LCD_MIRROR_X=y
CONFIG_BSP_CYD_ROTATE_180=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.cyd.csv"
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_LV_COLOR_DEPTH_16=y
# CONFIG_LV_USE_ASSERT_MALLOC is not set
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_MEM_SIZE_KILOBYTES=56
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
# Identity checks run during handshake, as in the Passport camera profile.
# CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE is not set
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# The touch/BOOT polling task must keep running while the screen is off.
# CONFIG_PM_ENABLE is not set
CONFIG_FREERTOS_HZ=1000
CONFIG_DAC_DMA_AUTO_16BIT_ALIGN=y
